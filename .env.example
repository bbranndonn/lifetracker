# Public build-time config. Copy to .env.local (ignored by Git), then restart Vite.
# For deployment, set these before building. Never use a client secret here.
VITE_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# Optional shared fallback only. Leave blank so each person connects their own sheet.
# Accepts a spreadsheet ID or full Google Sheets URL; a saved personal choice wins.
VITE_SHEET_ID=
# Illustrative addresses only; replace with your two Google account emails.
VITE_ALLOWED_EMAILS=person-one@example.com,person-two@example.com
# Optional; defaults to 7. A positive number of days.
VITE_SESSION_DAYS=7
